{
  "manifest_version": 3,
  "name": "DealSonar",
  "version": "0.1.0",
  "description": "DealSonar browser companion",
  "minimum_chrome_version": "116",
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_popup": "src/popup/index.html" },
  "permissions": ["nativeMessaging", "storage"]
}
