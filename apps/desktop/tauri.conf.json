{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DealSonar",
  "version": "0.1.0",
  "identifier": "com.dealsonar.desktop",
  "build": {
    "beforeDevCommand": "pnpm --filter @dealsonar/desktop-ui dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm --filter @dealsonar/desktop-ui build",
    "frontendDist": "ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "DealSonar",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost https://ipc.localhost tauri: http://tauri.localhost; object-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
